{
  "name": "somethingbetter-website",
  "version": "0.1.0",
  "private": true,
  "description": "Something Better Australia — website",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace @somethingbetter/backend",
    "dev:frontend": "npm run dev --workspace @somethingbetter/frontend",
    "build": "npm run build --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
